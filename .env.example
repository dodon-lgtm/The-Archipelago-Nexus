APP_NAME=Vexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Timezone ─────────────────────────────────────────────────────────────
# APP_TIMEZONE = timezone PENYIMPANAN timestamp (created_at, updated_at, ...).
#   Biarkan UTC: seluruh timestamp ditulis dalam UTC agar konsisten. Mengubahnya
#   ke WIB tanpa migrasi data akan membuat semua timestamp lama meleset 7 jam.
# APP_DISPLAY_TIMEZONE = timezone yang ditampilkan ke user (WIB).
#   Konversi dilakukan saat render lewat \App\Support\Cast::wib(), bukan
#   penambahan "+7 jam" manual.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Penerima form kontak "Hubungi Kami via Email" pada Pusat Bantuan.
MAIL_HELP_TO=kitaayo94@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── TEMPORARY / TESTING FLOW (Payment Confirmation) ─────────
# PERINGATAN: Hanya untuk TESTING. Jangan aktifkan di production.
# Saat true, Company dapat mengonfirmasi pembayaran dari halaman gateway
# (backend endpoint) tanpa menunggu webhook Midtrans, agar workspace terbuka.
# Setelah webhook Midtrans diperbaiki, set menjadi false.
PAYMENT_TEMPORARY_CONFIRMATION=false

VITE_APP_NAME="${APP_NAME}"
